{
  // De instellingen van TypeScript voor Op Wielen: dezelfde als die van Het Groenhuis.
  "compilerOptions": {
    // Welk JavaScript er uitkomt, en hoe modules werken: zoals in Node 24
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],

    // Streng nakijken
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Afspraken zodat Node de bestanden zelf kan uitvoeren
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",

    // tsc kijkt alleen na, Node voert uit
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
