{
  // De build: van src/ naar JavaScript en declaratiebestanden in dist/. Uitleg: hoofdstuk 14.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"],
  "exclude": ["src/start.ts"]
}
